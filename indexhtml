<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="NEXORA — Premium Digital Agency. Professional websites starting at $29.">
<link rel="icon" type="image/jpeg" href="https://i.imgur.com/XRLsmbg.jpeg">
<title>NEXORA — Premium Digital Agency | Web Development · AI Solutions · E-Commerce</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@300;400;500;600;700&display=swap');

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}

:root{
  --bg:#050507;--bg2:#0a0a0f;--card:rgba(255,255,255,0.03);--card2:rgba(255,255,255,0.06);
  --t1:#f5f5f7;--t2:rgba(245,245,247,0.6);--t3:rgba(245,245,247,0.4);
  --ac:#6366f1;--ac2:#818cf8;--acg:rgba(99,102,241,0.15);--ac3:#8b5cf6;--ac4:#06b6d4;
  --bd:rgba(255,255,255,0.06);--bd2:rgba(255,255,255,0.12);
}

html{scroll-behavior:smooth;scrollbar-width:thin;scrollbar-color:var(--ac) var(--bg)}
body{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;background:var(--bg);color:var(--t1);overflow-x:hidden;-webkit-font-smoothing:antialiased;line-height:1.6}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:var(--bg)}::-webkit-scrollbar-thumb{background:var(--ac);border-radius:3px}

.cur{position:fixed;width:24px;height:24px;border:1.5px solid var(--ac2);border-radius:50%;pointer-events:none;z-index:99998;transition:width .3s,height .3s;transform:translate(-50%,-50%);mix-blend-mode:difference}
.dot{position:fixed;width:5px;height:5px;background:var(--ac2);border-radius:50%;pointer-events:none;z-index:99998;transform:translate(-50%,-50%)}

.loader{position:fixed;inset:0;background:var(--bg);z-index:100000;display:flex;align-items:center;justify-content:center;flex-direction:column;transition:opacity .8s,visibility .8s}
.loader.done{opacity:0;visibility:hidden;pointer-events:none}
.loader img{width:80px;height:80px;object-fit:contain;border-radius:16px;animation:lRev 1s ease forwards}
.lbw{width:200px;height:2px;background:var(--bd);border-radius:2px;margin-top:28px;overflow:hidden}
.lb{height:100%;background:linear-gradient(90deg,var(--ac),var(--ac3));border-radius:2px;animation:lBar 2s ease forwards}
@keyframes lRev{0%{opacity:0;transform:translateY(10px) scale(.9)}100%{opacity:1;transform:translateY(0) scale(1)}}
@keyframes lBar{0%{width:0}100%{width:100%}}

.bgG{position:fixed;inset:0;pointer-events:none;z-index:0;background-image:linear-gradient(rgba(255,255,255,.015) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.015) 1px,transparent 1px);background-size:80px 80px}
.orb{position:fixed;border-radius:50%;filter:blur(120px);pointer-events:none;z-index:0;animation:orbF 15s ease-in-out infinite}
.o1{width:600px;height:600px;background:radial-gradient(circle,rgba(99,102,241,.12),transparent 70%);top:-200px;left:-200px}
.o2{width:500px;height:500px;background:radial-gradient(circle,rgba(139,92,246,.08),transparent 70%);top:50%;right:-200px;animation-delay:-5s}
.o3{width:400px;height:400px;background:radial-gradient(circle,rgba(6,182,212,.06),transparent 70%);bottom:-100px;left:30%;animation-delay:-10s}
@keyframes orbF{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(40px,-30px) scale(1.05)}66%{transform:translate(-20px,20px) scale(.95)}}
.pts{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.pt{position:absolute;width:2px;height:2px;background:var(--ac2);border-radius:50%;opacity:0;animation:ptF linear infinite}
@keyframes ptF{0%{opacity:0;transform:translateY(100vh) scale(0)}10%{opacity:.5}90%{opacity:.5}100%{opacity:0;transform:translateY(-20vh) scale(1)}}
.glow{position:fixed;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(99,102,241,.06),transparent 60%);pointer-events:none;z-index:1;transform:translate(-50%,-50%)}

.nav{position:fixed;top:0;left:0;right:0;z-index:1000;padding:0 48px;height:72px;display:flex;align-items:center;justify-content:space-between;background:rgba(5,5,7,.6);backdrop-filter:blur(40px) saturate(1.5);-webkit-backdrop-filter:blur(40px) saturate(1.5);border-bottom:1px solid var(--bd);transition:background .4s}
.nav.sc{background:rgba(5,5,7,.92)}
.nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none}
.nav-logo img{width:38px;height:38px;object-fit:contain;border-radius:10px}
.nav-logo span{font-family:'Space Grotesk',sans-serif;font-size:1.4rem;font-weight:700;letter-spacing:-.03em;background:linear-gradient(135deg,#fff,rgba(255,255,255,.75));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.nav-links{display:flex;align-items:center;gap:32px;list-style:none}
.nav-links a{color:var(--t2);text-decoration:none;font-size:.875rem;font-weight:450;transition:color .3s;position:relative}
.nav-links a:hover{color:var(--t1)}
.nav-links a::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:1px;background:var(--ac);transition:width .3s}
.nav-links a:hover::after{width:100%}
.nav-cta{display:flex;align-items:center;gap:12px}
.btn-n{padding:10px 20px;border-radius:10px;font-size:.85rem;font-weight:500;text-decoration:none;transition:all .3s;cursor:pointer;border:none;font-family:'Inter',sans-serif}
.btn-ng{background:transparent;color:var(--t2)}
.btn-ng:hover{color:var(--t1)}
.btn-np{background:linear-gradient(135deg,var(--ac),var(--ac3));color:white;box-shadow:0 0 20px var(--acg)}
.btn-np:hover{transform:translateY(-1px);box-shadow:0 0 30px rgba(99,102,241,.3)}
.mob-tog{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;background:none;border:none}
.mob-tog span{width:22px;height:1.5px;background:var(--t1);transition:all .3s}

.hero{min-height:100vh;display:flex;align-items:center;justify-content:center;position:relative;padding:120px 48px 80px;overflow:hidden}
.hl{position:absolute;top:-30%;left:50%;transform:translateX(-50%);width:800px;height:600px;background:radial-gradient(ellipse,rgba(99,102,241,.15) 0%,transparent 60%);pointer-events:none;animation:hlp 6s ease-in-out infinite}
@keyframes hlp{0%,100%{opacity:.6;transform:translateX(-50%) scale(1)}50%{opacity:1;transform:translateX(-50%) scale(1.1)}}
.hero-c{text-align:center;max-width:900px;position:relative;z-index:2}
.hbadge{display:inline-flex;align-items:center;gap:8px;padding:6px 16px 6px 8px;background:var(--card);border:1px solid var(--bd);border-radius:100px;font-size:.8rem;color:var(--t2);margin-bottom:32px;animation:fiu .8s ease forwards;backdrop-filter:blur(10px)}
.bdot{width:8px;height:8px;background:#22c55e;border-radius:50%;animation:pls 2s ease-in-out infinite}
@keyframes pls{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.8)}}
.ht{font-family:'Space Grotesk',sans-serif;font-size:clamp(2.8rem,7vw,5.5rem);font-weight:700;line-height:1.05;letter-spacing:-.04em;margin-bottom:24px;animation:fiu .8s ease .1s forwards;opacity:0}
.gr{background:linear-gradient(135deg,var(--ac2),var(--ac3),var(--ac4));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;background-size:200% 200%;animation:gs 5s ease infinite}
@keyframes gs{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
.hs{font-size:clamp(1rem,2vw,1.2rem);color:var(--t2);max-width:580px;margin:0 auto 40px;line-height:1.7;animation:fiu .8s ease .2s forwards;opacity:0}
.hacts{display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap;animation:fiu .8s ease .3s forwards;opacity:0}
.btn-wa{display:inline-flex;align-items:center;gap:10px;padding:18px 36px;background:linear-gradient(135deg,#25d366,#128c7e);color:white;font-size:1rem;font-weight:700;border-radius:16px;text-decoration:none;border:none;cursor:pointer;transition:all .4s;box-shadow:0 4px 30px rgba(37,211,102,.3),inset 0 1px 0 rgba(255,255,255,.15);font-family:'Inter',sans-serif;letter-spacing:-.01em}
.btn-wa:hover{transform:translateY(-3px);box-shadow:0 8px 40px rgba(37,211,102,.5)}
.btn-wa-2{display:inline-flex;align-items:center;gap:10px;padding:18px 36px;background:var(--card);color:var(--t1);font-size:1rem;font-weight:600;border-radius:16px;text-decoration:none;border:1px solid var(--bd);cursor:pointer;transition:all .3s;backdrop-filter:blur(10px);font-family:'Inter',sans-serif}
.btn-wa-2:hover{background:var(--card2);border-color:var(--bd2);transform:translateY(-2px)}
.hm{display:flex;align-items:center;justify-content:center;gap:48px;margin-top:64px;animation:fiu .8s ease .4s forwards;opacity:0}
.hmv{font-family:'Space Grotesk',sans-serif;font-size:2rem;font-weight:700;background:linear-gradient(135deg,var(--t1),var(--t2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hml{font-size:.78rem;color:var(--t3);margin-top:4px;text-transform:uppercase;letter-spacing:.08em;font-weight:500}
.fcs{position:absolute;inset:0;pointer-events:none;z-index:1}
.fc{position:absolute;background:rgba(255,255,255,.03);backdrop-filter:blur(20px);border:1px solid var(--bd);border-radius:16px;padding:18px;animation:flt 8s ease-in-out infinite}
.fc1{top:20%;left:5%;width:185px;animation-delay:-2s}
.fc2{top:30%;right:5%;width:170px;animation-delay:-4s}
.fc3{bottom:15%;left:10%;width:155px;animation-delay:-1s}
@keyframes flt{0%,100%{transform:translateY(0) rotate(0deg)}25%{transform:translateY(-15px) rotate(1deg)}75%{transform:translateY(10px) rotate(-1deg)}}
.fci{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1rem;margin-bottom:8px}
.fct{font-size:.72rem;color:var(--t2);font-weight:500}
.fcv{font-family:'Space Grotesk',sans-serif;font-size:1rem;font-weight:600;margin-top:2px}
@keyframes fiu{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}

section{position:relative;z-index:2}
.sc{max-width:1200px;margin:0 auto;padding:0 48px}
.sh{text-align:center;margin-bottom:60px}
.sl{display:inline-flex;align-items:center;gap:8px;font-size:.73rem;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:var(--ac2);margin-bottom:14px}
.sl::before,.sl::after{content:'';width:20px;height:1px;background:linear-gradient(90deg,transparent,var(--ac))}
.sl::after{background:linear-gradient(90deg,var(--ac),transparent)}
.st{font-family:'Space Grotesk',sans-serif;font-size:clamp(2rem,4vw,3rem);font-weight:700;letter-spacing:-.03em;line-height:1.15;margin-bottom:14px}
.sd{font-size:1rem;color:var(--t2);max-width:540px;margin:0 auto;line-height:1.7}

/* TRUSTED */
.trusted{padding:55px 0;border-top:1px solid var(--bd);border-bottom:1px solid var(--bd);background:rgba(255,255,255,.01)}
.trl{text-align:center;font-size:.73rem;text-transform:uppercase;letter-spacing:.12em;color:var(--t3);margin-bottom:28px;font-weight:500}
.tlogos{display:flex;align-items:center;justify-content:center;gap:50px;flex-wrap:wrap;opacity:.4;transition:opacity .3s}
.tlogos:hover{opacity:.6}
.tlogo{font-family:'Space Grotesk',sans-serif;font-size:1.2rem;font-weight:600;color:var(--t2)}

/* SERVICES */
.srv{padding:130px 0}
.srv-g{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.srv-c{background:var(--card);border:1px solid var(--bd);border-radius:22px;padding:36px 28px;transition:all .5s cubic-bezier(.23,1,.32,1);position:relative;overflow:hidden}
.srv-c::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--ac),transparent);opacity:0;transition:opacity .4s}
.srv-c:hover{background:var(--card2);border-color:var(--bd2);transform:translateY(-4px)}
.srv-c:hover::before{opacity:1}
.si{width:48px;height:48px;border-radius:13px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;margin-bottom:20px}
.srv-t{font-family:'Space Grotesk',sans-serif;font-size:1.15rem;font-weight:600;margin-bottom:10px}
.srv-d{font-size:.88rem;color:var(--t2);line-height:1.7;margin-bottom:20px}
.srv-f{list-style:none;display:flex;flex-direction:column;gap:7px}
.srv-f li{font-size:.8rem;color:var(--t3);display:flex;align-items:center;gap:7px}
.srv-f li::before{content:'✓';color:var(--ac2);font-size:.68rem;font-weight:700}

/* TEMPLATES */
.tpls{padding:130px 0;background:linear-gradient(180deg,transparent,rgba(99,102,241,.02),transparent)}
.tpl-tabs{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;margin-bottom:44px}
.tpl-tab{padding:9px 20px;background:var(--card);border:1px solid var(--bd);border-radius:100px;font-size:.8rem;font-weight:500;color:var(--t2);cursor:pointer;transition:all .3s;font-family:'Inter',sans-serif}
.tpl-tab:hover{border-color:var(--bd2);color:var(--t1)}
.tpl-tab.active{background:linear-gradient(135deg,var(--ac),var(--ac3));border-color:transparent;color:white}
.tpl-g{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.tpl-c{background:var(--card);border:1px solid var(--bd);border-radius:22px;overflow:hidden;transition:all .6s cubic-bezier(.23,1,.32,1);cursor:pointer;position:relative;display:none}
.tpl-c.vis{display:block}
.tpl-c:hover{border-color:var(--bd2);transform:translateY(-8px);box-shadow:0 24px 60px rgba(0,0,0,.4),0 0 40px var(--acg)}
.tpl-prev{height:240px;position:relative;overflow:hidden}
.tpl-prev-in{position:absolute;inset:12px;border-radius:10px;overflow:hidden;border:1px solid var(--bd);transition:transform .5s}
.tpl-c:hover .tpl-prev-in{transform:scale(1.04)}
.tpl-ov{position:absolute;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(4px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;opacity:0;transition:opacity .4s;z-index:10}
.tpl-c:hover .tpl-ov{opacity:1}
.tpl-ov-btn{padding:10px 22px;border-radius:10px;font-size:.82rem;font-weight:600;cursor:pointer;border:none;font-family:'Inter',sans-serif;transition:transform .2s;width:80%}
.tpl-ov-btn:hover{transform:scale(1.04)}
.btn-wa-tpl{background:linear-gradient(135deg,#25d366,#128c7e);color:white}
.btn-info-tpl{background:linear-gradient(135deg,var(--ac),var(--ac3));color:white}
.tpl-info{padding:20px 22px}
.tpl-type{font-size:.68rem;text-transform:uppercase;letter-spacing:.08em;color:var(--ac2);font-weight:600;margin-bottom:5px}
.tpl-name{font-family:'Space Grotesk',sans-serif;font-size:1rem;font-weight:600;margin-bottom:5px}
.tpl-desc{font-size:.78rem;color:var(--t2);line-height:1.6;margin-bottom:12px}
.tpl-meta{display:flex;align-items:center;justify-content:space-between}
.tpl-tag{padding:4px 10px;background:rgba(99,102,241,.08);border:1px solid rgba(99,102,241,.15);border-radius:100px;font-size:.68rem;color:var(--ac2);font-weight:500}

.mbar{height:26px;background:rgba(255,255,255,.04);border-bottom:1px solid var(--bd);display:flex;align-items:center;padding:0 10px;gap:5px}
.md{width:6px;height:6px;border-radius:50%;display:inline-block}
.md1{background:#ff5f57}.md2{background:#ffbd2e}.md3{background:#28c840}

/* STATS */
.stats{padding:90px 0;background:var(--bg2);border-top:1px solid var(--bd);border-bottom:1px solid var(--bd)}
.stats-g{display:grid;grid-template-columns:repeat(4,1fr);gap:28px}
.stat-c{text-align:center;padding:36px 20px;border-radius:22px;background:var(--card);border:1px solid var(--bd);transition:all .4s}
.stat-c:hover{border-color:var(--bd2);transform:translateY(-4px)}
.stat-n{font-family:'Space Grotesk',sans-serif;font-size:2.6rem;font-weight:700;background:linear-gradient(135deg,var(--ac2),var(--ac3));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:4px}
.stat-l{font-size:.83rem;color:var(--t2)}
.stat-sl{font-size:.7rem;color:var(--t3);margin-top:3px}

/* TESTIMONIALS */
.test{padding:130px 0}
.test-g{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.test-c{background:var(--card);border:1px solid var(--bd);border-radius:22px;padding:32px 28px;transition:all .4s;display:flex;flex-direction:column}
.test-c:hover{border-color:var(--bd2);background:var(--card2);transform:translateY(-4px)}
.test-stars{display:flex;gap:2px;margin-bottom:18px;color:#fbbf24;font-size:.88rem}
.test-txt{font-size:.92rem;color:var(--t2);line-height:1.75;flex:1;margin-bottom:20px;font-style:italic}
.test-auth{display:flex;align-items:center;gap:12px;padding-top:18px;border-top:1px solid var(--bd)}
.test-av{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:700;background:linear-gradient(135deg,var(--ac),var(--ac3));color:white;font-size:.9rem}
.test-name{font-size:.88rem;font-weight:600}
.test-role{font-size:.73rem;color:var(--t3)}

/* PRICING */
.price{padding:130px 0}
.price-g{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;align-items:start;max-width:940px;margin:0 auto}
.price-c{background:var(--card);border:1px solid var(--bd);border-radius:22px;padding:40px 32px;transition:all .4s;position:relative}
.price-c.feat{background:var(--card2);border-color:var(--ac);box-shadow:0 0 60px var(--acg);transform:scale(1.04)}
.price-c:hover{border-color:var(--bd2);transform:translateY(-4px)}
.price-c.feat:hover{transform:scale(1.04) translateY(-4px)}
.price-pop{position:absolute;top:-13px;left:50%;transform:translateX(-50%);padding:4px 16px;background:linear-gradient(135deg,var(--ac),var(--ac3));color:white;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;border-radius:100px;white-space:nowrap}
.price-medal{font-size:1.8rem;margin-bottom:14px}
.price-name{font-family:'Space Grotesk',sans-serif;font-size:1.25rem;font-weight:700;margin-bottom:5px}
.price-desc{font-size:.8rem;color:var(--t3);margin-bottom:24px;line-height:1.6}
.price-pr{display:flex;align-items:baseline;gap:4px;margin-bottom:24px}
.price-cur{font-size:1.2rem;font-weight:600;color:var(--t2)}
.price-amt{font-family:'Space Grotesk',sans-serif;font-size:3.2rem;font-weight:700;letter-spacing:-.04em;line-height:1}
.price-div{height:1px;background:var(--bd);margin-bottom:20px}
.price-ft{font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;color:var(--t3);font-weight:600;margin-bottom:12px}
.price-fl{list-style:none;display:flex;flex-direction:column;gap:9px;margin-bottom:28px}
.price-fl li{font-size:.83rem;color:var(--t2);display:flex;align-items:flex-start;gap:9px;line-height:1.5}
.price-fl li::before{content:'✓';color:var(--ac2);font-weight:700;font-size:.73rem;margin-top:2px;flex-shrink:0}
.price-bf{padding:12px;background:rgba(99,102,241,.04);border:1px solid rgba(99,102,241,.1);border-radius:10px;margin-bottom:22px}
.price-bfl{font-size:.66rem;text-transform:uppercase;letter-spacing:.08em;color:var(--ac2);font-weight:600;margin-bottom:3px}
.price-bft{font-size:.78rem;color:var(--t2);line-height:1.5}
.btn-wa-price{width:100%;padding:14px;border-radius:12px;font-size:.88rem;font-weight:700;cursor:pointer;transition:all .3s;border:none;text-align:center;text-decoration:none;display:block;font-family:'Inter',sans-serif}
.btn-wa-green{background:linear-gradient(135deg,#25d366,#128c7e);color:white;box-shadow:0 4px 20px rgba(37,211,102,.25)}
.btn-wa-green:hover{box-shadow:0 8px 30px rgba(37,211,102,.4);transform:translateY(-2px)}
.btn-wa-outline{background:transparent;color:var(--t1);border:1px solid var(--bd)}
.btn-wa-outline:hover{border-color:var(--bd2);background:var(--card)}

/* WHY */
.why{padding:75px 0;background:var(--bg2);border-top:1px solid var(--bd)}
.why-g{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.why-i{display:flex;align-items:center;gap:10px;padding:14px 18px;background:var(--card);border:1px solid var(--bd);border-radius:12px;transition:all .3s}
.why-i:hover{border-color:var(--bd2);background:var(--card2)}
.why-t{font-size:.83rem;font-weight:500;color:var(--t2)}

/* FAQ */
.faq{padding:100px 0}
.faq-list{max-width:700px;margin:0 auto;display:flex;flex-direction:column;gap:11px}
.faq-i{background:var(--card);border:1px solid var(--bd);border-radius:14px;overflow:hidden;transition:border-color .3s}
